          "Software & solvers",
          "Research programs",
          "Optical resources",
          "Experimental methods"
        ]
      },
      "zh-CN": {
        "label": "光学与光子学",
        "summary": "选择光学软件与研究程序，开展镜头设计、波动光学、电磁与光子器件计算，并读取对应的研究和实验方法。",
        "capabilities": [
          "软件与求解器",
          "研究程序",
          "光学资料",
          "实验方法"
        ]
      }
    },
    "resources": [
      {
