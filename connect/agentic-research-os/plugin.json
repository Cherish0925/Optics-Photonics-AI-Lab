    "optics": {
      "transport": "stdio",
      "command": "${RESEARCH_PYTHON}",
      "args": [
        "-B",
        "${PACKAGE_ROOT}/server.py",
        "mcp"
      ],
      "protocol_version": "2025-11-25",
      "env": {
        "OPTICS_SOFTWARE_HOME": "${WORKSPACE_ROOT}/System/software/optics-photonics"
      }
    }
